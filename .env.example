# Copie para .env (produção) ou .env.dev (desenvolvimento) e substitua os valores.
SPRING_PROFILES_ACTIVE=prod

POSTGRES_URL=jdbc:postgresql://postgres-db:5432/ccomp-db
POSTGRES_USER=ccomp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ccomp-db

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=ccomp
RABBITMQ_PASSWORD=change-me

PUBLIC_KEY=change-me
PRIVATE_KEY=change-me
# Nome legado aceito durante a migração de ambiente:
PRIVITE_KEY=change-me

MAIL_HOST=smtp.example.com
MAIL_PORT=587
USERNAME=change-me
MAIL_PASSWORD=change-me
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true

FRONTEND_PASSWORD_RESET_URL=https://example.com/reset-password
FRONTEND_ACCEPT_EDITOR_INVITE_URL=https://example.com/editor-invitation/
FRONTEND_SECURITY_NEW_LOGIN=https://example.com/security

STORAGE_ENDPOINT=http://seaweeds:9000
STORAGE_USER=change-me
STORAGE_PASSWORD=change-me
STORAGE_BUCKET=images
STORAGE_REGION=us-east-1

OTEL_OTLP_ENDPOINT=http://grafana-lgtm:4318
REDIS_HOST=redis
REDIS_PORT=6379
