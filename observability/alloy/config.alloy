discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "ccomp" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "ccomp"
    action        = "keep"
  }
}

loki.source.docker "ccomp" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.ccomp.output
  labels     = { job = "ccomp" }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://grafana-lgtm:3100/loki/api/v1/push"
  }
}

prometheus.scrape "postgres" {
  targets = [{
    __address__ = "postgres-exporter:9187",
  }]
  forward_to      = [prometheus.remote_write.lgtm.receiver]
  scrape_interval = "15s"
}

prometheus.remote_write "lgtm" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

prometheus.scrape "rabbitmq" {
  targets = [{
    __address__ = "rabbitmq:15692",
  }]
  forward_to = [prometheus.remote_write.lgtm.receiver]
}
